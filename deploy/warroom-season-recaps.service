# The Wednesday recap job (APE-308), started by warroom-season-recaps.timer. Asks the running app to
# keep and settle every connected league's last week for the recap archive; see
# deploy/warroom-season-job.sh. Needs CRON_SECRET in /etc/warroom/.env. Install alongside the timer:
#
#   sudo cp deploy/warroom-season-recaps.service deploy/warroom-season-recaps.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now warroom-season-recaps.timer
#
# Each run logs a summary line in the app's journal (`journalctl -u warroom | grep season-recaps`).
# Per-league failures are [server-error] lines there; a failed run emails through OnFailure=.

[Unit]
Description=Fantasy War Room weekly recaps
After=warroom.service
Requires=warroom.service
OnFailure=warroom-alert-failed@%n.service

[Service]
Type=oneshot
User=warroom
Group=warroom
EnvironmentFile=/etc/warroom/.env
ExecStart=/srv/warroom/current/deploy/warroom-season-job.sh recaps
TimeoutStartSec=1h

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
