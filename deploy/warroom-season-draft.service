# The draft-day reminder (APE-336), started every 15 minutes by warroom-season-draft.timer. Almost
# every run finds no connected league drafting 45-60 minutes from now and does nothing; see
# deploy/warroom-season-job.sh. Needs CRON_SECRET in /etc/warroom/.env. Install:
#
#   sudo cp deploy/warroom-season-draft.service deploy/warroom-season-draft.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now warroom-season-draft.timer
#
# Runs that found a draft log a summary line in the app's journal (`journalctl -u warroom | grep season-draft`).

[Unit]
Description=Fantasy War Room draft-day reminders
After=warroom.service
Requires=warroom.service
OnFailure=warroom-alert-failed@%n.service

[Service]
Type=oneshot
User=warroom
Group=warroom
EnvironmentFile=/etc/warroom/.env
ExecStart=/srv/warroom/current/deploy/warroom-season-job.sh draft
TimeoutStartSec=10min

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
