# The hosted app, run by systemd on the droplet. Install:
#
#   sudo cp deploy/warroom.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now warroom
#
# deploy/deploy.sh points /srv/warroom/current at a built release and restarts this unit.
# Secrets come from /etc/warroom/.env: KEY=value lines, no `export`; double-quote values with spaces.
# Next listens on localhost only; Caddy (deploy/Caddyfile) serves the public HTTPS site.

[Unit]
Description=Fantasy War Room
After=network-online.target postgresql.service
Wants=network-online.target
# Crash-looping (5 starts in 5 minutes) marks the unit failed, which emails ALERT_EMAIL.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=warroom-alert-failed@%n.service

[Service]
Type=simple
User=warroom
Group=warroom
WorkingDirectory=/srv/warroom/current
EnvironmentFile=/etc/warroom/.env
Environment=NODE_ENV=production
# The home directory is read-only to the service, so there is nowhere to store telemetry state.
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
# Next waits for open connections before exiting; don't let that hold a restart for 90s.
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Next writes its runtime cache under .next/cache inside the release.
ReadWritePaths=/srv/warroom/releases

[Install]
WantedBy=multi-user.target
