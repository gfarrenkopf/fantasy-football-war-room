# Nightly database backup, started by warroom-backup.timer. Writes a verified dump with
# scripts/db-backup.sh and deletes dumps older than 14 days. Install alongside the timer:
#
#   sudo cp deploy/warroom-backup.service deploy/warroom-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now warroom-backup.timer
#
# Run one now with `sudo systemctl start warroom-backup`; see the result with
# `journalctl -u warroom-backup`. These dumps stay on the droplet; see docs/deployment.md §8.

[Unit]
Description=Fantasy War Room database backup
After=postgresql.service

[Service]
Type=oneshot
User=warroom
Group=warroom
EnvironmentFile=/etc/warroom/env
ExecStart=/srv/warroom/current/scripts/db-backup.sh /var/backups/warroom
ExecStartPost=/usr/bin/find /var/backups/warroom -name "warroom-*.dump" -mtime +14 -delete

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/warroom
