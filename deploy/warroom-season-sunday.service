# The Sunday-morning AI lineup job (docs/in-season.md §6), started by warroom-season-sunday.timer.
# Asks the running app to write every entitled league's Sunday AI lineup and email it; see
# deploy/warroom-season-job.sh. Needs CRON_SECRET in /etc/warroom/.env. Install alongside the timer:
#
#   sudo cp deploy/warroom-season-sunday.service deploy/warroom-season-sunday.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now warroom-season-sunday.timer
#
# Run one now with `sudo systemctl start warroom-season-sunday`; see the result (a JSON summary)
# with `journalctl -u warroom-season-sunday`. Per-league failures are [server-error] lines in the
# app's journal, which warroom-alerts picks up; a failed run emails through OnFailure=.

[Unit]
Description=Fantasy War Room Sunday AI lineups
After=warroom.service
Requires=warroom.service
OnFailure=warroom-alert-failed@%n.service

[Service]
Type=oneshot
User=warroom
Group=warroom
EnvironmentFile=/etc/warroom/.env
ExecStart=/srv/warroom/current/deploy/warroom-season-job.sh sunday
TimeoutStartSec=1h

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
