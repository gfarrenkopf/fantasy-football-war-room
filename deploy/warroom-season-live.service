# The Game day Live Activity updates (21.5), started every minute by
# warroom-season-live.timer. Almost every run finds no Live Activity and no game on, and does
# nothing; see deploy/warroom-season-job.sh. Needs CRON_SECRET and the APNS_* variables in /etc/warroom/.env. Install:
#
#   sudo cp deploy/warroom-season-live.service deploy/warroom-season-live.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now warroom-season-live.timer
#
# Runs that pushed something log a summary line in the app's journal (`journalctl -u warroom | grep season-live`).

[Unit]
Description=Fantasy War Room Game day Live Activity updates
After=warroom.service
Requires=warroom.service
OnFailure=warroom-alert-failed@%n.service

[Service]
Type=oneshot
User=warroom
Group=warroom
EnvironmentFile=/etc/warroom/.env
ExecStart=/srv/warroom/current/deploy/warroom-season-job.sh live
TimeoutStartSec=55s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
