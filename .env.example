# Fantasy War Room environment variables
#
# NONE of these are required. With nothing set, the app runs as the free,
# self-hosted draft room (board, mock draft, availability report) using
# bundled sample data.
#
# Copy to .env.local and fill in only what you need:
#   cp .env.example .env.local
#
# Only src/lib/config.ts reads these. Don't use process.env anywhere else.

# --- Cloud: accounts + cross-device league sync (Epic 3) ---------------------
# Both DATABASE_URL and NEXTAUTH_SECRET are needed to turn on cloud features.

# Postgres connection string.
DATABASE_URL=

# Secret used to sign auth sessions. Generate one with: opens
NEXTAUTH_SECRET=

# Public base URL of the deployment, e.g. https://warroom.example.com
# (optional in local development)
NEXTAUTH_URL=

# --- AI-generated draft plan (Epic 5) ----------------------
# AI plan provider (see src/lib/ai/providers) and optional model override
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=

# --- Payments (Epic 4) --------------------------------------------------------
# Needs cloud features on. Stripe dashboard > Developers > API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Data pipeline: live ADP / projections / injuries (Epic 2) ---------------
# Works on its own. Get a key at https://sportsdata.io
SPORTSDATA_API_KEY=

# --- Login & Email Congif ----------------------------------
AUTH_RESEND_KEY=
EMAIL_FROM=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRECT=